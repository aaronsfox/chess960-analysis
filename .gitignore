# Engine binaries and networks are installed locally, never committed
engines/*/bin/*
engines/*/networks/*
!engines/*/bin/.gitkeep
!engines/*/networks/.gitkeep

# Results: production outputs in results/evaluate_sp/ and the opening book in
# results/opening_book/ are committed so the data is archived with the code.
# Anything else under results/ (test runs with --output-dir results/test,
# etc.) stays local.
results/*
!results/evaluate_sp/
!results/opening_book/
logs/
*.tmp

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/
