# Engine binaries and networks are installed locally, never committed
engines/*/bin/*
engines/*/networks/*
!engines/*/bin/.gitkeep
!engines/*/networks/.gitkeep
tools/*/bin/*
!tools/*/bin/.gitkeep

# Results: production outputs in results/evaluate_sp/, the opening book in
# results/opening_book/, the self-play games, tables and run records in
# results/selfplay/, the pilot runs in results/pilot/, the parsed Lichess Chess960 games in results/lichess960/ and the paper's figures
# in results/figures/ are committed so they are archived with the code. Anything else under results/ (test runs
# with --output-dir results/test, etc.) stays local.
results/*
!results/evaluate_sp/
!results/opening_book/
!results/figures/
!results/selfplay/
!results/pilot/
!results/lichess960/
logs/
data/lichess/
results/lichess960/prepared/
*.tmp

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/
